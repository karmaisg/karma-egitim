{
  "name": "karma-egitim",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Yalnızca /api/* istekleri sunucu koduna gider, diğer dosyalar doğrudan sunulur.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      // Veritabanı yoksa Cloudflare ilk yüklemede "karma-egitim-db" adıyla otomatik oluşturur.
      // Otomatik oluşturma çalışmazsa README.md içindeki "Sorun giderme" bölümüne bakın.
      "binding": "DB",
      "database_name": "karma-egitim-db"
    }
  ],
  "observability": { "enabled": true }
}
